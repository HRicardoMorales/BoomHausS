# Variables del frontend (todas opcionales; se cargan en Vercel → Settings → Environment Variables).
# La URL del backend está fija en src/services/api.js.

# Nombre visible de la tienda (default: Amelor)
VITE_STORE_NAME=Amelor

# WhatsApp de atención, solo dígitos con código de país (ej. 5491112345678)
VITE_WHATSAPP_NUMBER=

# Email de soporte que se muestra en el footer y en Cambios y devoluciones
VITE_SUPPORT_EMAIL=

# Meta Pixel — mismo ID que el META_PIXEL_ID del backend.
# Si no está definido, el Pixel del navegador queda deshabilitado (no-op).
VITE_META_PIXEL_ID=

# Solo en el build (no VITE_): dominio canónico para og:image, canonical y sitemap.
# SITE_URL=https://amelor.com.ar
