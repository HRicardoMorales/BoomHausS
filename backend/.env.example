# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 64+ chars random. Rotar cada 6 meses o ante sospecha de leak.
# Ejemplo de generacion: `openssl rand -base64 64`
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
# Origen unico permitido (opcional). Usar CLIENT_URLS para multiples.
CLIENT_URL=http://localhost:5173
# Lista separada por comas de origenes permitidos.
# CLIENT_URLS=http://localhost:5173,https://boomhauss.com.ar,https://www.boomhauss.com.ar

# URL publica del frontend — usada para MP back_urls y links de reset password.
FRONTEND_URL=http://localhost:5173

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Access token de PRODUCCION (o TEST-... para sandbox).
# Dashboard MP → Tu integracion → Credenciales de produccion.
MP_ACCESS_TOKEN=APP_USR-REPLACE_ME

# Public key expuesta al frontend via GET /api/orders/mp-public-key.
MP_PUBLIC_KEY=APP_USR-REPLACE_ME

# Clave secreta del webhook. Dashboard MP → Tu integracion → Webhooks →
# Configuracion de la clave secreta. SIN esto, mercadopagoWebhook rechaza
# todos los webhooks con 401 (comportamiento por diseño post-hardening).
MP_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# URL de imagen para el checkout de MP (opcional, aparece en el detalle
# del pago). 250x250 recomendado.
# MP_STORE_IMAGE_URL=https://tu-cdn/logo.png

# ─── Pricing enforcement ──────────────────────────────────────────────────────
# shadow: recalcula server-side y loguea discrepancias contra frontendTotal,
#         pero cobra lo que mando el frontend. Fase de acumulacion de datos.
# enforce: usa siempre el expectedTotal server-side. Bloquea manipulacion.
# Default: shadow.
PRICE_ENFORCEMENT=shadow

# ─── Producto unico (solo si usas GET /api/products/single) ───────────────────
# SINGLE_PRODUCT_ID=

# ─── Email — Resend (recomendado) ─────────────────────────────────────────────
# Si RESEND_API_KEY existe, se usa Resend. Si no, SMTP.
# RESEND_API_KEY=re_REPLACE_ME

# ─── Email — SMTP (fallback) ──────────────────────────────────────────────────
# Ejemplo Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=cuenta@gmail.com  SMTP_PASS=<app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BoomHausS <no-reply@boomhauss.com.ar>"

# ─── Branding en emails ───────────────────────────────────────────────────────
STORE_NAME=BoomHausS
WHATSAPP_NUMBER=54911XXXXXXX

# ─── Cloudinary (comprobantes de transferencia) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ─── Meta Conversions API (CAPI) — deduplicacion server-side ─────────────────
# Purchase sale del backend (orders.controller / mercadopagoWebhook /
# card-payment). Funnel events (ViewContent, AddToCart, InitiateCheckout,
# AddPaymentInfo) salen por POST /api/track desde el frontend con el mismo
# eventID que el fbq() browser.
#
# Token: Meta Events Manager → tu pixel → Configuracion → Generar token.
META_PIXEL_ID=META_PIXEL_ID_PLACEHOLDER
META_CAPI_TOKEN=META_CAPI_TOKEN_PLACEHOLDER
# CAPI_ENABLED=true para enviar realmente; cualquier otro valor = dry-run.
CAPI_ENABLED=false
# Opcional: codigo de "Probar eventos" en Events Manager.
# META_TEST_EVENT_CODE=TEST12345
