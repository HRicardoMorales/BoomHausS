PORT=4000
NODE_ENV=development

# DB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME

# Auth
JWT_SECRET=pon_un_secret_largo_y_unico

# Frontend (CORS)
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=http://localhost:5173,https://tu-frontend.vercel.app

# Email (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Meta Conversions API (CAPI) — deduplicación server-side de eventos.
# Purchase sale del backend (orders.controller / mercadopagoWebhook / card-payment).
# Funnel events (ViewContent, AddToCart, InitiateCheckout, AddPaymentInfo) salen
# por POST /api/track desde el frontend con el mismo eventID que el fbq() browser.
#
# Obtené el token en: Meta Events Manager → tu píxel → Configuración → Generar token
META_PIXEL_ID=META_PIXEL_ID_PLACEHOLDER
META_CAPI_TOKEN=META_CAPI_TOKEN_PLACEHOLDER
# CAPI_ENABLED=true para enviar realmente; cualquier otro valor = dry-run (solo log)
CAPI_ENABLED=false
# Opcional: para "Probar eventos" del Administrador de eventos
# META_TEST_EVENT_CODE=TEST12345
